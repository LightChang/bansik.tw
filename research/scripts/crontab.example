# 定時更新範例。**這份是給 server 用的，開發機不要掛**——本機只負責把腳本準備好，
# 等專案移到 server 再 crontab -e 貼進去，並把下面兩個路徑改成 server 上的實際位置。
#
# sync.py 自己會判斷哪些來源到期，所以固定每天跑一次就好，
# 不需要為 daily / weekly / yearly 各排一條。

REPO=/Users/lightman/weiqi.kids/bansik.tw          # server 上要改
PY=/Users/lightman/miniforge3/bin/python           # server 上要改

# 每天 07:30 抓到期的來源（含中山醫的放名額公告，那是唯一需要每日盯的）
30 7 * * * cd $REPO && $PY research/scripts/sync.py --due >> research/work/sync.log 2>&1

# 每天 08:00 重新解析成資料集（原始檔沒變時輸出也不會變，成本很低）
# 順序不能換：districts.py 先產出行政區中心點，build.py 才補得了沒有座標的那 1,695 家；
# renames.py 要拿 build 出來的新版去跟上一版快照比，所以排最後。
0 8 * * * cd $REPO && $PY research/scripts/districts.py research/work research/build >> research/work/build.log 2>&1
5 8 * * * cd $REPO && $PY research/scripts/build.py research/work research/build >> research/work/build.log 2>&1
20 8 * * * cd $REPO && $PY research/scripts/renames.py research/build research/entity_prev.csv >> research/work/build.log 2>&1

# 每月 1 號把兩個大型素材 PDF 也檢查一次（平常跳過，各 25MB / 102MB）
0 9 1 * * cd $REPO && $PY research/scripts/sync.py --due --with-big >> research/work/sync.log 2>&1

# 看排程狀態：
#   $PY research/scripts/sync.py --list
# 只看這次會抓什麼、不動手：
#   $PY research/scripts/sync.py --due --dry-run
