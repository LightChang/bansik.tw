---
// 類型頁、行政區頁、行政區×類型頁共用的本體。三種頁只差在「名單怎麼挑」與「往哪裡連」，
// 表格、引用前提、先打哪支電話都一樣。
//
// 名單在建置期就輸出成真的表格列：這些頁存在的理由就是讓搜尋引擎與 AI 工具
// 不跑 JS 也讀得到「某區有哪幾家語言治療所」。
import Base from '../layouts/Base.astro';
import Nav from './Nav.astro';
import SiteFooter from './SiteFooter.astro';
import Caveat from './Caveat.astro';
import { obsLine } from '../lib/view.mjs';
import {
  typePages, districtPages, typeDistrictPages, shortCounty,
  typeUrl, districtUrl, typeDistrictUrl,
} from '../lib/facets.mjs';

interface Props {
  code: string;
  c: any;
  list: any[];
  type?: any;
  district?: string;
}
const { code, c, list, type, district } = Astro.props;

const S = shortCounty(c.county);
const C = c.county;
const where = district ? `${C}${district}` : C;
const n = list.length;

const allTypes = typePages(c);
const allDistricts = districtPages(c);
const combos = typeDistrictPages(c);
const comboFor = (d, slug) => combos.find((x) => x.district === d && x.type.slug === slug);

// 分到哪幾區：類型頁用。家數多的在前。
const byDistrict = [...list.reduce((m, e) => {
  if (e.district) m.set(e.district, (m.get(e.district) || 0) + 1);
  return m;
}, new Map()).entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'zh-Hant'));

// 這一區各類型幾家：行政區頁用。
const typeCounts = allTypes
  .map(({ type: t }) => ({ t, k: list.filter(t.match).length }))
  .filter((x) => x.k > 0);

// 社家署名錄原本的類別（家長看得懂的寫法），行政區頁的開頭句用
const catCounts = [...list.reduce((m, e) => m.set(e.plain_cat, (m.get(e.plain_cat) || 0) + 1), new Map())
  .entries()].sort((a, b) => b[1] - a[1]);

const title = type
  ? type.title(district ? `${S}${district}` : S, n)
  : `${S}${district}兒童發展與早療機構｜${n} 家名單`;
const h1 = type ? type.h1(where) : `${where}兒童發展相關機構`;
const names = list.slice(0, 3).map((e) => e.name).join('、');
const description = type
  ? `${where}${type.label}相關單位 ${n} 家（${names}等）的地址與電話，依主管機關公開名錄整理。`
  : `${where} ${n} 家兒童發展相關機構（${names}等）：篩檢、評估、療育各類的地址與電話。`;

const top = byDistrict.slice(0, 3).map(([d, k]) => `${d}（${k} 家）`).join('、');
const lead = type
  ? (district
      ? `${where}有 ${n} 家${type.label}相關單位列在主管機關名錄裡。`
      : `${C}有 ${n} 家${type.label}相關單位列在主管機關名錄裡，分布在 ${byDistrict.length} 個行政區`
        + (top ? `，最多的是${top}。` : '。'))
  : `${where}有 ${n} 家兒童發展相關機構列在主管機關名錄裡：`
    + catCounts.slice(0, 4).map(([k, v]) => `${k} ${v} 家`).join('、') + '。';

// 行政區頁優先放設在同一區的通報轉介中心
const referrals = c.entities.filter((e) => e.journey_step === '2');
const referral = (district && referrals.find((e) => e.district === district)) || referrals[0];

const trail = district && type
  ? [{ name: district, path: districtUrl(code, district) }, { name: type.label }]
  : [{ name: district || type.label }];

// ItemList：讓引擎知道這張表是一份機構清單，每一筆是一個地點。
// 只放名錄裡真的有的欄位，沒有的就不寫。
const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: h1,
  numberOfItems: n,
  itemListElement: list.map((e, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Place',
      name: e.name,
      ...(e.address ? { address: e.address } : {}),
      ...(e.tel ? { telephone: e.tel } : {}),
      ...(e.url ? { url: e.url } : {}),
    },
  })),
};
---

<Base title={title} description={description} trail={trail}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(itemList)} />
  <Nav current={code} />
  <main class="shell">
    <p class="crumb">
      {district && type
        ? <a href={districtUrl(code, district)}>← {district}全部機構</a>
        : <a href={`/${code}/places/`}>← {C}全部機構</a>}
    </p>
    <h1>{h1}</h1>
    <p class="lead">{lead}</p>
    {type && <p class="meta">這一頁收的是：{type.basis}</p>}

    {type && !district && byDistrict.length > 1 && (
      <section class="section">
        <h2>{C}各區{type.label}家數</h2>
        <nav class="pagenav">
          {byDistrict.map(([d, k]) => {
            const combo = comboFor(d, type.slug);
            return combo
              ? <a href={typeDistrictUrl(code, d, type.slug)}>{d} {k} 家</a>
              : <span>{d} {k} 家</span>;
          })}
        </nav>
      </section>
    )}

    {!type && typeCounts.length > 0 && (
      <section class="section">
        <h2>{district}依服務類型找</h2>
        <nav class="pagenav">
          {typeCounts.map(({ t, k }) => {
            const combo = comboFor(district, t.slug);
            return <a href={combo ? typeDistrictUrl(code, district, t.slug) : typeUrl(code, t.slug)}>
              {combo ? `${district}${t.label} ${k} 家` : `${t.label} ${k} 家（看${S}全部）`}
            </a>;
          })}
        </nav>
      </section>
    )}

    <section class="section">
      <h2>{where}{type ? type.label : ''}名單</h2>
      <div class="table-wrap">
        <table>
          <caption>
            {where}{type ? type.label : '兒童發展'}相關單位 {n} 家：名稱、類型、地址與電話。
            資料產生於 {c.generated_at.slice(0, 10)}。
          </caption>
          <thead><tr><th>名稱</th><th>類型</th><th>地址</th><th>電話</th></tr></thead>
          <tbody>
            {list.map((e) => {
              const obs = obsLine(c.observations, e.entity_key, e.tel);
              return (
                <tr>
                  <td>
                    {e.tier && <span class={`pill ${e.tier === '重點' ? 'key' : ''}`}>{e.tier}</span>}
                    {e.url ? <a href={e.url} target="_blank" rel="noopener">{e.name}</a> : e.name}
                  </td>
                  <td>{e.plain_cat}</td>
                  <td>
                    {e.address}
                    {e.geo_level === 'district' && <span class="meta">（座標只到行政區）</span>}
                    {obs && <div class="meta">{obs}</div>}
                  </td>
                  <td class="num">{e.tel}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>

    <Caveat kind="list" />

    {referral && (
      <div class="cards">
        <div class="card call">
          <h3>不確定該找哪一類，先打這支</h3>
          <div class="entry">
            <span>{referral.name}</span>
            <span class="tel num">{referral.tel}</span>
          </div>
          <p class="meta">{referral.cat}。不確定下一步該找哪一類，可以先打這支問。</p>
        </div>
      </div>
    )}

    <section class="section">
      <h2>{S}其他服務類型</h2>
      <nav class="pagenav">
        {allTypes.filter((p) => !type || p.type.slug !== type.slug).map((p) => (
          <a href={typeUrl(code, p.type.slug)}>{p.type.label} {p.list.length} 家</a>
        ))}
        {district && type && <a href={typeUrl(code, type.slug)}>{S}全部{type.label}</a>}
      </nav>
    </section>

    {allDistricts.length > 1 && (
      <section class="section">
        <h2>{S}其他行政區</h2>
        <nav class="pagenav">
          {allDistricts.filter((p) => p.district !== district).map((p) => (
            <a href={districtUrl(code, p.district)}>{p.district} {p.list.length} 家</a>
          ))}
          <a href={`/${code}/map/`}>{S}各區家數分布</a>
        </nav>
      </section>
    )}

    <SiteFooter code={code} generatedAt={c.generated_at} />
  </main>
</Base>
