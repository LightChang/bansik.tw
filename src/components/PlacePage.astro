---
// 單一機構頁。內容只用名錄裡已有的欄位（名稱、類別、地址、電話、網址、國健署層級、
// 衛生局頁解析出的門診與預約方式、健保醫事機構代碼、社家署名錄的服務方式／內容／區域／辦理單位），
// 沒有的欄位就不出現，不替機構補它沒登記的服務。社家署欄位原文照列，不改寫、不歸納。
import Base from '../layouts/Base.astro';
import Nav from './Nav.astro';
import SiteFooter from './SiteFooter.astro';
import Caveat from './Caveat.astro';
import { obsLine } from '../lib/view.mjs';
import {
  SERVICE_TYPES, typePages, districtPages, typeUrl, districtUrl, shortCounty,
} from '../lib/facets.mjs';
import {
  CAT_TEXT, catList, placeSlugs, placeUrl, noindexReason, serviceWords, schemaType, titleNames,
} from '../lib/placepages.mjs';
import { place } from '../lib/jsonld.mjs';
import { counties, county } from '../lib/data.mjs';

interface Props {
  code: string;
  c: any;
  e: any;
}
const { code, c, e } = Astro.props;

const C = c.county;
const S = shortCounty(C);
const where = `${C}${e.district || ''}`;
const cats = catList(e);
const words = serviceWords(e);
const noindex = noindexReason(e);
const slugs = placeSlugs(c);
const obs = obsLine(c.observations, e.entity_key, e.tel);

// 標題與 description 用本名（去掉法人別與「(時段)」類註記），H1 以下仍用名錄全名
const tname = titleNames(c).get(e.entity_key) || e.name;
const title = `${tname}｜${where} ${words.join('・') || '兒童發展'}`;
const catText = cats.map((k) => CAT_TEXT[k] || k);
const description = `${tname}（${where}）：${catText.join('、')}。`
  + `地址 ${e.address}，電話 ${e.tel}。附${S}評估與早療補助的申請流程。`;

const SOURCE_NAME = {
  sfaa: '衛福部社家署發展遲緩兒童早期療育資源名錄',
  healthforkids: '國健署兒童發展篩檢院所名單',
  hpa: '國健署兒童發展聯合評估中心名單',
};
const sources = (e.sources || '').split(';').filter(Boolean).map((s) => SOURCE_NAME[s] || s);
if (e.hosp_id) sources.push('健保署特約醫療院所名冊');

// 社家署名錄每一筆的原文欄位（服務方式、服務內容、服務區域、辦理單位、更新日期）。
// 一家可能登記好幾筆（不同類別、日間／時段各一筆），每筆分開列。只有更新日期的筆不另成一段。
const SFAA_URL = 'https://system.sfaa.gov.tw/cecm/resourceView/detail2?qtype1=1&qtype2=4';
const towns = c.towns || [];
const areaText = (a) => {
  const list = a.split(/[,，、]/).map((x) => x.trim()).filter(Boolean);
  // 名錄把全縣市的區逐一列出時，照實縮寫成「全區（N 區）」，區名不再重複一長串
  if (towns.length > 1 && list.length === towns.length && towns.every((t) => list.includes(t))) {
    return `${C}全部 ${towns.length} 個行政區（名錄逐一列出）`;
  }
  return list.length > 1 ? list.join('、') : a;
};
// 「服務內容」偶爾只填了郵遞區號加行政區（「40201臺中市南區」），那不是服務內容，不列
const ZIP_ONLY = /^\d{3,6}\S{2,4}[市縣]\S{1,4}[區鄉鎮市]$/;
const sfaaRecs = (e.sfaa || [])
  .map((r) => (r.content && ZIP_ONLY.test(r.content.trim()) ? { ...r, content: '' } : r))
  .filter((r) => r.area || r.mode || r.content || r.operator);
const sfaaMulti = sfaaRecs.length > 1;

// 國健署聯評中心名單的層級：家數從全國資料算，不寫死
let tierCounts = null;
if (e.tier) {
  tierCounts = { 重點: 0, 一般: 0 };
  for (const { code: k } of counties()) {
    for (const x of county(k).entities) if (x.tier) tierCounts[x.tier] = (tierCounts[x.tier] || 0) + 1;
  }
}

const lead = `${e.name}位於${where}，列在主管機關名錄的類別是${catText.join('、')}。`
  + `地址是${e.address}，電話 ${e.tel}。`;

// 這一家符合的服務類型頁（有出頁的才連）
const myTypes = typePages(c).filter(({ type }) => type.match(e));
const dpage = districtPages(c).find((p) => p.district === e.district);
const evalPage = typePages(c).find(({ type }) => type.slug === 'evaluation');

// 同區其他機構：同類型的排前面，最多 12 家
const matchTypes = SERVICE_TYPES.filter((t) => t.match(e));
const score = (x) => matchTypes.filter((t) => t.match(x)).length;
const nearby = c.entities
  .filter((x) => x.entity_key !== e.entity_key && e.district && x.district === e.district)
  .sort((a, b) => score(b) - score(a) || a.name.localeCompare(b.name, 'zh-Hant'))
  .slice(0, 12);

// 不確定先打哪支：同區的通報轉介／個管中心優先
const referrals = c.entities.filter((x) => x.journey_step === '2' && x.entity_key !== e.entity_key);
const referral = referrals.find((x) => x.district === e.district) || referrals[0];

// 結構化資料：與上方表格同一筆 e，欄位規則見 src/lib/jsonld.mjs 的 place()
const ld = place(e, { type: schemaType(e), county: C });
---

<Base title={title} description={description} trail={[{ name: e.name }]} noindex={!!noindex} jsonld={[ld]}>
  <Nav current={code} />
  <main class="shell">
    <p class="crumb">
      {dpage
        ? <a href={districtUrl(code, e.district)}>← {e.district}全部機構</a>
        : <a href={`/${code}/places/`}>← {S}早療機構一覽</a>}
    </p>
    <h1>{e.name}</h1>
    <p class="lead">{lead}</p>

    <section class="section">
      <h2>{e.name}的基本資料</h2>
      <div class="table-wrap">
        <table>
          <caption>{e.name}的名錄資料。資料產生於 {c.generated_at.slice(0, 10)}。</caption>
          <tbody>
            <tr><th>名稱</th><td>{e.tier && <span class={`pill ${e.tier === '重點' ? 'key' : ''}`}>{e.tier}</span>}{e.name}</td></tr>
            <tr><th>類型</th><td>{catText.join('、')}</td></tr>
            <tr><th>所在地</th><td>{where}</td></tr>
            <tr>
              <th>地址</th>
              <td>{e.address}{e.geo_level === 'district' && <span class="meta">（地圖座標只到行政區）</span>}</td>
            </tr>
            <tr><th>電話</th><td class="num">{e.tel}</td></tr>
            {obs && <tr><th>門診與預約</th><td>{obs}</td></tr>}
            {e.url && <tr><th>網址</th><td><a href={e.url} target="_blank" rel="noopener">{e.url}</a></td></tr>}
            {e.tier && (
              <tr>
                <th>評估中心層級</th>
                <td>
                  國健署補助的兒童發展聯合評估中心（{e.tier}中心）。
                  國健署名單把補助的中心分成重點中心與一般中心兩級，全國重點 {tierCounts.重點} 家、一般 {tierCounts.一般} 家。
                </td>
              </tr>
            )}
            {e.hosp_id && (
              <tr><th>健保特約</th><td>列在健保署特約醫療院所名冊，醫事機構代碼 <span class="num">{e.hosp_id}</span></td></tr>
            )}
            <tr><th>資料來源</th><td>{sources.join('、')}</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    {sfaaRecs.length > 0 && (
      <section class="section">
        <h2>{e.name}在社家署名錄登記的服務</h2>
        {sfaaRecs.map((r) => (
          <div class="table-wrap">
            <table>
              <caption>
                {sfaaMulti ? `${r.name || e.name}・${CAT_TEXT[r.cat] || r.cat}` : e.name}的登記內容，
                照衛福部社家署發展遲緩兒童早期療育資源名錄原文{r.updated && `，名錄更新日期民國 ${r.updated}`}。
              </caption>
              <tbody>
                {r.mode && <tr><th>服務方式</th><td>{r.mode}</td></tr>}
                {r.content && <tr><th>服務內容</th><td class="pre">{r.content}</td></tr>}
                {r.area && <tr><th>服務區域</th><td>{areaText(r.area)}</td></tr>}
                {r.operator && <tr><th>辦理單位</th><td>{r.operator}</td></tr>}
              </tbody>
            </table>
          </div>
        ))}
        <p class="meta">
          來源：<a href={SFAA_URL} target="_blank" rel="noopener">衛福部社家署發展遲緩兒童通報暨個案管理服務網・資源查詢</a>。
          名錄沒有填的欄位這裡就不列；實際時段、名額與收費以機構自己的說明為準。
        </p>
      </section>
    )}

    <section class="section">
      <h2>{e.name}列在哪些服務名單</h2>
      <ul>
        {cats.map((k) => <li>{CAT_TEXT[k] || k}</li>)}
      </ul>
      <p class="meta">
        這是主管機關名錄登記的類別，實際開放的療育項目、時段與收費，以機構自己的說明為準。
      </p>
      {myTypes.length > 0 && (
        <nav class="pagenav">
          {myTypes.map(({ type, list }) => (
            <a href={typeUrl(code, type.slug)}>{S}{type.label} {list.length} 家</a>
          ))}
        </nav>
      )}
    </section>

    <Caveat kind="list" />

    <section class="section">
      <h2>在{C}：評估、療育到補助的下一步</h2>
      <ul>
        <li><a href={`/${code}/steps/`}>{S}早療怎麼開始：從篩檢、通報到療育的五步</a></li>
        {evalPage
          ? <li><a href={typeUrl(code, 'evaluation')}>{S}兒童發展評估：聯合評估中心與評估醫院 {evalPage.list.length} 家</a></li>
          : <li><a href={`/${code}/checkups/`}>{S}兒童發展篩檢與評估時程</a></li>}
        <li><a href={`/${code}/subsidy/`}>{S}早療補助怎麼申請：資格、文件與窗口</a></li>
      </ul>
    </section>

    {referral && (
      <div class="cards">
        <div class="card call">
          <h3>不確定該找哪一類，先打這支</h3>
          <div class="entry">
            <span>{referral.name}</span>
            <span class="tel num">{referral.tel}</span>
          </div>
          <p class="meta">{referral.cat}。評估、療育、補助該從哪裡開始，可以先打這支問。</p>
        </div>
      </div>
    )}

    {nearby.length > 0 && (
      <section class="section">
        <h2>{e.district}其他兒童發展與早療機構</h2>
        <ul>
          {nearby.map((x) => (
            <li>
              <a href={placeUrl(code, slugs.get(x.entity_key))}>{x.name}</a>
              <span class="meta">（{CAT_TEXT[catList(x)[0]] || x.cat}）</span>
            </li>
          ))}
        </ul>
        <nav class="pagenav">
          {dpage && <a href={districtUrl(code, e.district)}>{e.district}全部 {dpage.list.length} 家</a>}
          <a href={`/${code}/places/`}>{S}早療機構一覽</a>
        </nav>
      </section>
    )}

    <SiteFooter code={code} generatedAt={c.generated_at} />
  </main>
</Base>
