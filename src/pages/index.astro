---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import { siteIndex, shared } from '../lib/data.mjs';

const idx = siteIndex();
const s = shared();
const list = idx.counties;
const totalEnt = list.reduce((n, c) => n + c.entities, 0);
const totalCtr = list.reduce((n, c) => n + c.centers, 0);

// 全國統計裡的「發展遲緩」特教學生數：學前有兩萬多人，國小之後是 0。
// 這是整個站最值得先講的一件事，首頁就講。
const dd = s.stats.filter((r) => r.metric === '特教學生數' && r.dim1_value === '發展遲緩');
const sum = (pick) => dd.filter((r) => pick(r.dim2_value)).reduce((n, r) => n + (Number(r.value) || 0), 0);
const pre = sum((v) => v.startsWith('學前'));
const after = sum((v) => !v.startsWith('學前'));

const desc = `全臺 ${totalEnt} 家兒童發展相關機構、${totalCtr} 家兒童發展聯合評估中心。`
  + '輸入孩子的月齡就知道現在該做哪一次篩檢、去哪裡評估、補助怎麼申請。';
---

<Base title="bansik 兒童發展地圖" description={desc}>
  <Nav />
  <main class="shell">
    <h1>孩子現在該做哪一次檢查？</h1>
    <p class="lead">
      發展篩檢、通報、評估、療育、學前教育——這五步由不同機關管，沒有任何一處把它們接起來。
      這個站把它們接起來：選你的縣市，拉到孩子的月齡，就知道現在這一格該做什麼、去哪裡。
    </p>

    <div class="cards">
      <div class="card">
        <h3 class="num">{totalEnt.toLocaleString()}</h3>
        <span class="sub">全臺兒童發展相關機構</span>
      </div>
      <div class="card">
        <h3 class="num">{totalCtr}</h3>
        <span class="sub">兒童發展聯合評估中心</span>
      </div>
      <div class="card">
        <h3 class="num">{list.length}</h3>
        <span class="sub">縣市，各自的補助規則不同</span>
      </div>
    </div>

    {pre > 0 && (
      <p class="handover">
        <b>入學後「發展遲緩」這個身分會消失</b>——全國學前有
        <span class="num">{pre.toLocaleString()}</span> 名發展遲緩學生，國小一年級以後是
        <span class="num">{after}</span> 人。這不是人不見了，是這個類別只用在學前；
        要繼續拿到特教資源，得在入學前的鑑定改判其他障別。
        <span class="src">教育部特殊教育通報統計</span>
      </p>
    )}

    <section class="section">
      <h2>選你的縣市</h2>
      <p class="lead">括號裡是該縣市已收錄的機構家數與聯合評估中心家數。</p>
      <div class="cards">
        {list.map((c) => (
          <a class="card" href={`/${c.code}/`}>
            <h3>{c.name}</h3>
            <span class="sub">
              <span class="num">{c.entities}</span> 家機構
              聯評中心 <span class="num">{c.centers}</span> 家
            </span>
          </a>
        ))}
      </div>
    </section>

    <footer class="site-ft">
      <p>
        資料產生於 {idx.generated_at.slice(0, 10)}
        來源：衛福部社家署、國健署、教育部特教通報網、各縣市衛生局與社會局。
      </p>
      <p>這裡是路標不是掛號窗口，不做品質排名，也不代為預約或試算。以主管機關公告為準。</p>
    </footer>
  </main>
</Base>
