---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Caveat from '../../components/Caveat.astro';
import { countyPaths, county } from '../../lib/data.mjs';
import { districtPages, typePages, districtUrl, shortCounty, MIN_DISTRICT } from '../../lib/facets.mjs';

export const getStaticPaths = countyPaths;

const { county: code } = Astro.params;
const c = county(code);

// 分布圖只畫到行政區，不畫門牌：全國 3,073 家裡只有一部分有門牌座標，其餘是區中心點，
// 混在一起畫會讓同一區的機構全部疊在一個點上，看起來像「這區只有一家」。
// 底圖也不放，直接用經緯度投影成 SVG，圓圈大小就是家數。
const geo = c.district_geo || {};
// 現行鄉鎮市區名單（內政部國土測繪中心，research/scripts/towns.json）。
// 圖資 district_geo 會混進服務區域的異寫（屏東「車城鎮」「霧台鄉」），有名單時只畫名單上的區
const towns = c.towns || [];
const names = Object.keys(geo).filter((n) => towns.length === 0 || towns.includes(n));
const cnt = (n) => (c.districts[n] || {}).located || 0;

let svg = null;
if (names.length > 0) {
  const lats = names.map((n) => geo[n].lat);
  const lngs = names.map((n) => geo[n].lng);
  const la0 = Math.min(...lats);
  const la1 = Math.max(...lats);
  const ln0 = Math.min(...lngs);
  const ln1 = Math.max(...lngs);
  // 經度要乘 cos(緯度) 才不會把地圖橫向拉寬（臺灣約 0.91）
  const k = Math.cos(((la0 + la1) / 2) * Math.PI / 180);
  const W = 640;
  const H = 480;
  const PAD = 56;
  const spanX = Math.max((ln1 - ln0) * k, 1e-6);
  const spanY = Math.max(la1 - la0, 1e-6);
  const scale = Math.min((W - PAD * 2) / spanX, (H - PAD * 2) / spanY);
  const cx = (n) => PAD + (geo[n].lng - ln0) * k * scale + ((W - PAD * 2) - spanX * scale) / 2;
  const cy = (n) => PAD + (la1 - geo[n].lat) * scale + ((H - PAD * 2) - spanY * scale) / 2;
  const max = Math.max(...names.map(cnt), 1);
  const r = (n) => 5 + Math.sqrt(cnt(n) / max) * 28;
  svg = {
    W,
    H,
    dots: [...names].sort((a, b) => cnt(b) - cnt(a)).map((n) => ({
      name: n,
      n: cnt(n),
      cx: +cx(n).toFixed(1),
      cy: +cy(n).toFixed(1),
      r: +r(n).toFixed(1),
      // 家數太少的不標字，不然圓圈小、字疊在一起看不清
      label: cnt(n) >= max * 0.18 ? n.replace(/[區鄉鎮市]$/, '') : null,
    })),
  };
}

// 表格列出現行全部鄉鎮市區（0 家的照實列 0），加上有機構設籍但不在名單上的寫法（理論上沒有）
const all = [...new Set([...towns, ...names, ...Object.keys(c.districts).filter((n) => cnt(n) > 0)])];
const sorted = all.sort((a, b) => cnt(b) - cnt(a) || a.localeCompare(b, 'zh-Hant'));
const withPlaces = sorted.filter((n) => cnt(n) > 0);

// 達到門檻的行政區有自己的靜態頁，其餘仍連到全表的 ?d= 篩選
const dpages = new Set(districtPages(c).map((p) => p.district));
const hrefOf = (n) => (dpages.has(n) ? districtUrl(code, n) : `/${code}/places/?d=${encodeURIComponent(n)}`);

// 每一區各服務類型幾家，只列有的
const types = typePages(c).map((p) => p.type);
const mixOf = (n) => {
  const here = c.entities.filter((e) => e.district === n);
  return types.map((t) => [t.label, here.filter(t.match).length]).filter(([, k]) => k > 0)
    .map(([l, k]) => `${l} ${k}`).join('・');
};

const S = shortCounty(c.county);
const N = towns.length;
// 「有哪些區」清單：照內政部名單的順序，有名單頁的連過去，其餘純文字
const townLinks = towns.map((n) => ({ name: n, href: dpages.has(n) ? districtUrl(code, n) : null }));
const townUnit = /市$/.test(c.county) && towns.every((t) => /區$/.test(t)) ? '區' : '鄉鎮市';
const top = withPlaces.slice(0, 3).map((n) => `${n}（${cnt(n)} 家）`).join('、');
const addressLevel = c.entities.filter((e) => e.geo_level === 'address').length;
---

<Base
  title={N ? `${S}有哪些區（共${N}區）｜各區兒童發展與早療機構家數` : `${S}各區兒童發展與早療機構家數｜哪一區有幾家`}
  description={(N ? `${c.county}共 ${N} 個${townUnit}：${towns.slice(0, 6).join('、')}${N > 6 ? '等' : ''}。` : '')
    + `兒童發展相關機構分布在 ${withPlaces.length} 個行政區、共 ${c.counts.entities} 家，`
    + `最多的是${top}。每一區可再看篩檢、評估、治療各類的名單。`}
>
  <Nav current={code} />
  <main class="shell">
    <p class="crumb"><a href={`/${code}/`}>← 回到「現在該做什麼」</a></p>
    <h1>{N ? `${c.county}有哪些區：共 ${N} 個${townUnit}與各區兒童發展機構家數` : `${c.county}各區有幾家兒童發展機構`}</h1>
    <p class="lead">
      {N > 0 && <>{c.county}共有 <span class="num">{N}</span> 個{townUnit}。</>}
      {c.county}的 <span class="num">{c.counts.entities}</span> 家兒童發展相關機構分布在
      <span class="num">{withPlaces.length}</span> 個行政區，最多的是{top}。
    </p>

    {N > 0 && (
      <section class="section">
        <h2>{c.county}的 {N} 個{townUnit}</h2>
        <p>{townLinks.map((t, i) => <>{i > 0 && '、'}{t.href ? <a href={t.href}>{t.name}</a> : t.name}</>)}</p>
        <p class="meta">
          行政區名單來源：內政部國土測繪中心行政區域資料（2026-10-02 取得）。
          有連結的區有自己的兒童發展機構名單頁（{MIN_DISTRICT} 家以上才出頁）。
        </p>
      </section>
    )}

    {svg ? (
      <>
        <p class="meta">
          圓圈畫在行政區的中心，大小是那一區的機構家數。
          這不是機構的實際位置，點一下圓圈會跳到那一區的名單。
        </p>
        <svg
          viewBox={`0 0 ${svg.W} ${svg.H}`}
          width="100%"
          style={`max-width:${svg.W}px`}
          role="img"
          aria-label={`${c.county}各行政區機構家數分布`}
        >
          {svg.dots.map((d) => (
            <a href={hrefOf(d.name)}>
              <title>{d.name} {d.n} 家</title>
              <circle
                cx={d.cx} cy={d.cy} r={d.r}
                fill="var(--color-pass)" fill-opacity="0.22"
                stroke="var(--color-pass)" stroke-width="1.5"
              />
              {d.label && (
                <text
                  x={d.cx} y={d.cy + 6}
                  text-anchor="middle"
                  font-size="18"
                  fill="var(--text-primary)"
                >{d.label} {d.n}</text>
              )}
            </a>
          ))}
        </svg>
      </>
    ) : (
      <p class="meta">這個縣市還沒有行政區座標，只能看下面的清單。</p>
    )}

    <section class="section">
      <h2>{S}各區家數</h2>
      <div class="table-wrap">
        <table>
          <caption>{c.county}各行政區的兒童發展相關機構家數。資料產生於 {c.generated_at.slice(0, 10)}。</caption>
          <thead><tr><th>行政區</th><th class="num">位於這一區</th><th>服務類型（一家可能算進兩類）</th></tr></thead>
          <tbody>
            {sorted.map((n) => (
              <tr>
                <td>{cnt(n) > 0 ? <a href={hrefOf(n)}>{n}</a> : n}</td>
                <td class="num">{cnt(n)}</td>
                <td>{mixOf(n)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="meta">
        全縣市 {c.counts.entities} 家。行政區中心點取自鄉鎮界圖資；
        機構自己的座標只有 {addressLevel} 家是門牌精度。
        {MIN_DISTRICT} 家以上的行政區有自己的名單頁，其餘連到全部機構的篩選。
      </p>
    </section>

    <Caveat kind="list" />

    <SiteFooter code={code} generatedAt={c.generated_at} />
  </main>
</Base>
