---
import Tel from '../../components/Tel.astro';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Caveat from '../../components/Caveat.astro';
import RecentPlaces from '../../components/RecentPlaces.astro';
import { countyPaths, countyBundle, SUBPAGES, subpageUrl } from '../../lib/data.mjs';
import { typePages, typeUrl, shortCounty } from '../../lib/facets.mjs';
import { scriptJson } from '../../lib/scriptjson.mjs';
import { NATIONAL } from '../../lib/national.mjs';
import { screenings, trackHtml, nowHtml, DEFAULT_AGE } from '../../lib/view.mjs';

export const getStaticPaths = countyPaths;

const { county: code } = Astro.params;
const { c, s } = countyBundle(code);

// 通報轉介中心（journey_step 2）：不知道從哪開始就打這支
const referrals = c.entities.filter((e) => e.journey_step === '2');
const call = referrals[0];

// 聯合評估中心，重點中心優先
const centers = c.entities
  .filter((e) => e.cat === '聯合評估中心')
  .sort((a, b) => (a.tier === '重點' ? -1 : b.tier === '重點' ? 1 : 0)
    || a.name.localeCompare(b.name, 'zh-Hant'));

// 名額必須跟它所屬的機構一起輸出。先前把它獨立放在清單末尾，窄螢幕隱藏第 2 列後
// 就變成「榜上是甲醫院、名額寫乙醫院」，會誤導家長。
const quotaOf = (key) => c.observations
  .filter((o) => o.entity_key === key && o.field === 'quota_release_date')
  .map((o) => o.value).sort()[0] || null;

// 0–5 個月大那一段要用的家數（發展篩檢要滿 6 個月才開始，但這段不是沒事做）
const ear = c.entities.filter((e) => e.cat === '新生兒聽力篩檢院所').length;
const earConfirm = c.entities.filter((e) => e.cat === '新生兒聽力確診醫院').length;

// 滿 7 歲那一格要講的事，數字從全國統計現算
const dd = s.stats.filter((r) => r.metric === '特教學生數' && r.dim1_value === '發展遲緩');
const sumBy = (pick) => dd.filter((r) => pick(r.dim2_value)).reduce((n, r) => n + (Number(r.value) || 0), 0);

// 瀏覽器只需要 timeline 與這幾個數字就能重畫「現在該做什麼」，
// 不必把 555 家機構也送過去——那是 /places/ 那一頁的事。
const payload = {
  county: c.county,
  timeline: s.timeline,
  ear,
  earConfirm,
  pre: sumBy((v) => v.startsWith('學前')),
  after: sumBy((v) => !v.startsWith('學前')),
};

const types = typePages(c);
const S = shortCounty(c.county);

// 六次篩檢的時程表在建置期就輸出：月齡互動區是 JS 畫的，這張表不跑 JS 也讀得到。
const SCREENS = screenings(s.timeline);
const screeningPage = types.find(({ type }) => type.slug === 'screening');
const lastBand = SCREENS.length ? SCREENS[SCREENS.length - 1].age_label : '';

const desc = `${c.county}的兒童發展篩檢時程與早期療育資源：${c.counts.entities} 家機構、`
  + `${c.counts.centers} 家兒童發展聯合評估中心。輸入孩子的月齡就知道現在該做哪一次篩檢、`
  + '去哪裡評估、補助怎麼申請。';
---

<Base title={`${c.county}兒童發展遲緩・早療資源｜篩檢時程、評估醫院、療育機構與補助`} description={desc}>
  <Nav current={code} />
  <main class="shell">
    <h1>{c.county}兒童發展地圖</h1>
    <p class="lead">
      拉動月齡，下面就會顯示這個月齡該做的事。
      {c.county}目前收錄 <span class="num">{c.counts.entities}</span> 家機構、
      <span class="num">{c.counts.centers}</span> 家聯合評估中心。
    </p>

    <div class="agebar">
      <div class="field">
        <label for="birth">出生年月</label>
        <input type="date" id="birth" />
      </div>
      <div class="field">
        <label for="age">月齡</label>
        <input type="range" id="age" min="0" max="84" step="1" value={DEFAULT_AGE}
               aria-describedby="ageOut" />
        <output id="ageOut" for="age">
          <span class="num" id="ageNum">{DEFAULT_AGE}</span> <small id="ageText">個月大</small>
        </output>
      </div>
    </div>

    {/* h2 不只是排版：搜尋與 AI 引擎靠標題判斷這一段在答什麼問題。
        月齡軸與卡片原本都只有 h3，整頁除了 h1 沒有第二層。 */}
    <h2 class="sr-band">這個月齡該做的事</h2>
    {/* 先用預設月齡輸出一次，瀏覽器載入後依家長選的月齡重畫（函式在 lib/view.mjs，兩邊共用） */}
    <div class="track" id="track" set:html={trackHtml(s.timeline, DEFAULT_AGE)} />

    <div class="now" id="now" set:html={nowHtml(payload, DEFAULT_AGE)} />

    {SCREENS.length > 0 && (
      <section class="section">
        <h2>六次兒童發展篩檢：幾個月大做哪一次</h2>
        <p class="lead">
          兒童健康手冊排了 {SCREENS.length} 次兒童發展篩檢，從 {Number(SCREENS[0].month_min)} 個月大開始，
          最後一次在{lastBand}。
          {screeningPage
            ? <>{c.county}可以做篩檢的院所有 <a href={typeUrl(code, 'screening')}>{screeningPage.list.length} 家</a>（國健署名單）。</>
            : <>{c.county}可以做篩檢的院所，可以先打下面的通報轉介中心問。</>}
        </p>
        <div class="table-wrap">
          <table>
            <caption>兒童發展篩檢的年齡區間，依國健署兒童健康手冊。</caption>
            <thead><tr><th>次數</th><th>孩子的年齡</th></tr></thead>
            <tbody>
              {SCREENS.map((t, i) => (
                <tr><td>第 {i + 1} 次</td><td>{t.age_label}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="meta">錯過某一次，下一個年齡區間照樣可以做；覺得孩子哪裡跟不上，不必等到下一次，可以直接找下面的評估中心或通報轉介中心。</p>
      </section>
    )}

    <h2>在{c.county}先找誰</h2>
    <div class="cards">
      {call && (
        <div class="card call">
          <h3>不知道從哪開始，先打這支</h3>
          <div class="entry">
            <span>{call.name}</span>
            <span class="tel num"><Tel tel={call.tel} /></span>
          </div>
          <p class="meta">
            通報轉介中心是單一窗口，{c.county}共 {referrals.length} 處，打這支會幫你轉。
          </p>
        </div>
      )}
      <div class="card">
        <h3>做評估的地方<span class="sub">{c.county} {centers.length} 家，重點中心優先</span></h3>
        {centers.slice(0, 3).map((e) => (
          <div class="entry-group">
            <div class="entry">
              <span>
                {e.tier && <span class={`pill ${e.tier === '重點' ? 'key' : ''}`}>{e.tier}</span>}
                {e.name}
              </span>
              <span class="tel num"><Tel tel={e.tel} /></span>
            </div>
            {quotaOf(e.entity_key) && (
              <p class="meta">下次開放名額 {quotaOf(e.entity_key)}（醫院公告，以院方為準）</p>
            )}
          </div>
        ))}
        {centers.length === 0 && (
          <p class="meta">
            {c.county}沒有設立聯合評估中心，需要跨縣市就醫；先打上面的通報轉介中心問。
          </p>
        )}
      </div>
    </div>

    <nav class="pagenav">
      {SUBPAGES.map(([slug, title]) => <a href={subpageUrl(code, slug)}>{title} →</a>)}
    </nav>

    {types.length > 0 && (
      <section class="section">
        <h2>在{c.county}依服務類型找</h2>
        <nav class="pagenav">
          {types.map(({ type, list }) => (
            <a href={typeUrl(code, type.slug)}>{S}{type.label} {list.length} 家</a>
          ))}
        </nav>
      </section>
    )}

    <section class="section">
      <h2>各縣市通用的說明</h2>
      <p class="lead">月齡對照、發展遲緩的定義與評估、早療流程與補助比較，全國都一樣的部分放在這幾頁。</p>
      <nav class="pagenav">
        {NATIONAL.map(([href, name]) => <a href={href}>{name} →</a>)}
      </nav>
    </section>

    <RecentPlaces code={code} />

    <Caveat kind="list" />

    <SiteFooter code={code} generatedAt={c.generated_at} />
  </main>

  <script type="application/json" id="bansik-data" set:html={scriptJson(payload)} />

  <script>
    import { ageText, trackHtml, nowHtml, DEFAULT_AGE } from '../../lib/view.mjs';

    const DATA = JSON.parse(document.getElementById('bansik-data').textContent);
    const el = (id) => document.getElementById(id);
    const NARROW = window.matchMedia('(max-width: 760px)');
    let age = DEFAULT_AGE;

    function setAge(m) {
      age = Math.max(0, Math.min(84, Math.round(m)));
      el('age').value = age;
      el('ageNum').textContent = age;
      el('ageText').textContent = ageText(age, NARROW.matches);
      el('track').innerHTML = trackHtml(DATA.timeline, age);
      el('now').innerHTML = nowHtml(DATA, age);
      try { localStorage.setItem('bansik:age', String(age)); } catch { /* 私密視窗會丟例外 */ }
    }

    // 視窗寬度跨過 760px 要重畫：ageText 會在「27 個月大」與
    // 「27 個月大（2 歲 3 個月）」之間切換，只在載入時判斷一次不夠。
    NARROW.addEventListener('change', () => setAge(age));

    el('age').addEventListener('input', (e) => setAge(+e.target.value));
    el('birth').addEventListener('change', (e) => {
      if (!e.target.value) return;
      const b = new Date(e.target.value);
      const n = new Date();
      setAge((n.getFullYear() - b.getFullYear()) * 12 + (n.getMonth() - b.getMonth()));
      trackAge('birthdate');
    });

    // 家長選了幾個月大送進 GA4，看得出哪個年齡段的人最多、內頁該先補哪一段。
    // 只送月齡，不送出生日期。input 事件拖曳時每一格都會觸發，改聽放開時的 change。
    // gtag 只在正式網域才存在（見 Base.astro）。
    function trackAge(method) {
      if (typeof window.gtag !== 'function') return;
      window.gtag('event', 'age_select', { age_months: age, method, county: DATA.county });
    }
    el('age').addEventListener('change', () => trackAge('slider'));

    // 記住上次看的月齡，內頁也讀同一個 key
    let start = DEFAULT_AGE;
    const q = new URLSearchParams(location.search).get('m');
    if (q !== null && q !== '' && Number.isFinite(+q)) {
      start = +q;
    } else {
      try {
        const saved = localStorage.getItem('bansik:age');
        if (saved !== null) start = +saved;
      } catch { /* 讀不到就用預設 */ }
    }
    setAge(start);
  </script>
</Base>
