---
import '../styles/site.css';
import { GA_MEASUREMENT_ID, GA_HOSTS, GSC_VERIFICATION } from '../site.config.mjs';
import { counties, county, siteIndex, SUBPAGES } from '../lib/data.mjs';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
}
const { title, description, canonical } = Astro.props;
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const url = canonical ?? `${site}${Astro.url.pathname}`;

// 結構化資料。每頁都給 WebPage 與麵包屑——搜尋與 AI 引擎靠它知道
// 這一頁在整個站的哪個位置、資料多新，不必自己從網址猜。
//
// 路徑自己推得出來，不必每個頁面各傳一次：/taichung/places/ 的兩段
// 分別查 counties.json 與 SUBPAGES 就有中文名稱。查不到就不放那一層，
// 寧可少一層麵包屑，也不要放一個編出來的名稱。
const seg = Astro.url.pathname.split('/').filter(Boolean);
const countyMeta = seg[0] ? counties().find((x) => x.code === seg[0]) : null;
const subTitle = seg[1] ? (SUBPAGES.find(([slug]) => slug === seg[1]) || [])[1] : null;

const crumbs = [{ name: '全國', url: `${site}/` }];
if (countyMeta) crumbs.push({ name: countyMeta.name, url: `${site}/${countyMeta.code}/` });
if (countyMeta && subTitle) crumbs.push({ name: subTitle, url });

// dateModified 用資料產生日，不用建置時間：重新建置不代表資料變新了，
// 拿建置時間當更新時間就是對引擎謊報新鮮度。
const dataDate = countyMeta ? county(countyMeta.code).generated_at : siteIndex().generated_at;

// Organization：站台身分的最小可驗證版本。只寫得出來、查得到的欄位——
// 沒有登記在案的統編、地址、電話或對外聯絡窗口，那些欄位不編，寧可少寫一項，
// 也不要交出殘缺欄位（半吊子的結構化資料在 Google 眼裡是「無效項目」，比沒有更糟）。
// 只在首頁輸出：Organization 是站台層級的單一實體，不必每一頁重複宣告；
// 其他頁面用 `{'@id': ...}` 參照同一個節點即可（見下方 isPartOf.publisher）。
const orgId = `${site}/#organization`;
const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': orgId,
  name: 'bansik｜兒童發展地圖',
  url: `${site}/`,
  description:
    '臺灣兒童發展篩檢與早期療育的資源地圖。以孩子的月齡為入口，回答三件事：'
    + '現在該做哪一次檢查、附近哪裡可以評估與療育、補助怎麼申請。',
  logo: `${site}/apple-touch-icon.png`,
};

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    url,
    inLanguage: 'zh-Hant-TW',
    isPartOf: {
      '@type': 'WebSite',
      '@id': `${site}/#website`,
      name: 'bansik｜兒童發展地圖',
      url: `${site}/`,
      publisher: { '@id': orgId },
    },
    ...(description ? { description } : {}),
    ...(dataDate ? { dateModified: dataDate.slice(0, 10) } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((c, i) => ({
      '@type': 'ListItem', position: i + 1, name: c.name, item: c.url,
    })),
  },
  ...(Astro.url.pathname === '/' ? [org] : []),
];
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={url} />

    {/* SVG 給桌機瀏覽器，ico 給舊瀏覽器與那些直接去要 /favicon.ico 的工具，
        apple-touch-icon 給 iOS 加到主畫面 */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
    />

    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:locale" content="zh_TW" />

    {GSC_VERIFICATION && <meta name="google-site-verification" content={GSC_VERIFICATION} />}

    {jsonld.map((b) => (
      <script type="application/ld+json" set:html={JSON.stringify(b)} />
    ))}
    <slot name="head" />
  </head>
  <body>
    <slot />
    {GA_MEASUREMENT_ID && (
      <script is:inline define:vars={{ gaId: GA_MEASUREMENT_ID, gaHosts: GA_HOSTS }}>
        // 主機名對不上就什麼都不做——連 gtag.js 的請求都不發出去。
        // 內頁是真實網址（/taichung/places/），每一頁都是一次正常的載入，
        // 所以不需要為了 hash 路由補送 page_view。
        if (gaHosts.indexOf(location.hostname) !== -1) {
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () { window.dataLayer.push(arguments); };
          window.gtag('js', new Date());
          window.gtag('config', gaId);
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
          document.head.appendChild(s);
        }
      </script>
    )}
  </body>
</html>
