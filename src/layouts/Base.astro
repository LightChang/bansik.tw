---
import '../styles/site.css';
import { GA_MEASUREMENT_ID, GA_HOSTS, GSC_VERIFICATION } from '../site.config.mjs';
import { counties, county, siteIndex, shared, SUBPAGES } from '../lib/data.mjs';
import { webPage, webSite, breadcrumbList, organization } from '../lib/jsonld.mjs';
import JsonLd from '../components/JsonLd.astro';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  /** 內頁底下再往下一層的麵包屑（/taichung/places/speech-therapy/），path 省略＝目前這一頁 */
  trail?: { name: string; path?: string }[];
  /** 資料太少、不值得被搜尋引擎收錄的頁（單一機構頁的一部分）。同時要從 sitemap 排除，見 astro.config.mjs */
  noindex?: boolean;
  /** 這一頁自己的結構化資料節點（由 src/lib/jsonld.mjs 組），接在 WebPage／麵包屑後面輸出 */
  jsonld?: unknown[];
}
const { title, description, canonical, trail, noindex, jsonld: extraJsonLd } = Astro.props;
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const url = canonical ?? `${site}${Astro.url.pathname}`;

// 結構化資料。每頁都給 WebPage，兩層以上的頁給麵包屑——搜尋與 AI 引擎靠它知道
// 這一頁在整個站的哪個位置、資料多新，不必自己從網址猜。節點在 src/lib/jsonld.mjs 組，
// 由 <JsonLd> 在 <head> 統一輸出；頁面自己的節點用 jsonld prop 傳進來。
//
// 路徑自己推得出來，不必每個頁面各傳一次：/taichung/places/ 的兩段
// 分別查 counties.json 與 SUBPAGES 就有中文名稱。查不到就不放那一層，
// 寧可少一層麵包屑，也不要放一個編出來的名稱。
const seg = Astro.url.pathname.split('/').filter(Boolean);
const countyMeta = seg[0] ? counties().find((x) => x.code === seg[0]) : null;
const subTitle = seg[1] ? (SUBPAGES.find(([slug]) => slug === seg[1]) || [])[1] : null;

const crumbs = [{ name: '全國', url: `${site}/` }];
if (countyMeta) crumbs.push({ name: countyMeta.name, url: `${site}/${countyMeta.code}/` });
if (countyMeta && subTitle) {
  crumbs.push({ name: subTitle, url: trail?.length ? `${site}/${seg[0]}/${seg[1]}/` : url });
  for (const t of trail || []) crumbs.push({ name: t.name, url: t.path ? `${site}${t.path}` : url });
}

// dateModified 用資料產生日，不用建置時間：重新建置不代表資料變新了，
// 拿建置時間當更新時間就是對引擎謊報新鮮度。
const dataDate = countyMeta ? county(countyMeta.code).generated_at : siteIndex().generated_at;

// citation：預設用站上時程／篩檢工具的資料底稿（src/data/shared.json 的 timeline[].url），
// 這裡去重取出，原樣列成來源引用——不得新增或改寫這裡沒有的網址。
// 補助頁例外：那一頁引用的是該縣市自己的補助法規（counties/<code>.json 的 subsidy），
// 不是篩檢時程，掛時程來源等於告訴引擎「這頁引用了它沒講的東西」，故改用 subsidy 自己的
// source_url／rule_name／verified_at。沒有 url 的整筆丟棄，陣列為空就整個屬性不輸出。
const subsidyRecord = (seg[1] === 'subsidy' && countyMeta) ? county(countyMeta.code).subsidy : null;
const citationEntries = subsidyRecord
  ? (subsidyRecord.source_url
      ? [{
          name: subsidyRecord.rule_name || subsidyRecord.county,
          url: subsidyRecord.source_url,
          dateModified: subsidyRecord.verified_at,
        }]
      : [])
  : [...new Map(
      shared().timeline.filter((t) => t.url).map((t) => [t.url, t.source])
    ).entries()].map(([url, name]) => ({ name, url }));

const home = Astro.url.pathname === '/';
const jsonld = [
  webPage({ site, url, title, description, dataDate, citations: citationEntries, home }),
  breadcrumbList(crumbs),
  home && webSite(site),
  home && organization(site),
  ...(extraJsonLd || []),
];
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={url} />
    {noindex && <meta name="robots" content="noindex,follow" />}

    {/* SVG 給桌機瀏覽器，ico 給舊瀏覽器與那些直接去要 /favicon.ico 的工具，
        apple-touch-icon 給 iOS 加到主畫面 */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
    />

    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:locale" content="zh_TW" />

    {GSC_VERIFICATION && <meta name="google-site-verification" content={GSC_VERIFICATION} />}

    <JsonLd items={jsonld} />
    <slot name="head" />
  </head>
  <body>
    <slot />
    {GA_MEASUREMENT_ID && (
      <script is:inline define:vars={{ gaId: GA_MEASUREMENT_ID, gaHosts: GA_HOSTS }}>
        // 主機名對不上就什麼都不做——連 gtag.js 的請求都不發出去。
        // 內頁是真實網址（/taichung/places/），每一頁都是一次正常的載入，
        // 所以不需要為了 hash 路由補送 page_view。
        if (gaHosts.indexOf(location.hostname) !== -1) {
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () { window.dataLayer.push(arguments); };
          window.gtag('js', new Date());
          window.gtag('config', gaId);
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
          document.head.appendChild(s);
        }
      </script>
    )}
  </body>
</html>
